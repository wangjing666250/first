      ],
      "@pillar-ui/pillar-ui/input": [
        "../packages/pillar-ui/src/components/input/index.ts"
      ],
      "@pillar-ui/pillar-ui/select": [
        "../packages/pillar-ui/src/components/select/index.ts"
      ],
      "@pillar-ui/pillar-ui/checkbox": [
        "../packages/pillar-ui/src/components/checkbox/index.ts"
      ],
      "@pillar-ui/pillar-ui/radio": [
        "../packages/pillar-ui/src/components/radio/index.ts"
      ],
      "@pillar-ui/pillar-ui/switch": [
        "../packages/pillar-ui/src/components/switch/index.ts"
      ],
      "@pillar-ui/pillar-ui/autocomplete": [
        "../packages/pillar-ui/src/components/autocomplete/index.ts"
      ],
      "@pillar-ui/pillar-ui/upload": [
        "../packages/pillar-ui/src/components/upload/index.ts"

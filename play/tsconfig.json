        "../packages/pillar-ui/src/components/tabs/index.ts"
      ],
      "@pillar-ui/pillar-ui/pagination": [
        "../packages/pillar-ui/src/components/pagination/index.ts"
      ],
      "@pillar-ui/pillar-ui/drawer": [
        "../packages/pillar-ui/src/components/drawer/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../packages/pillar-ui/env.d.ts",
